import urllib.request
import json

# Using an open, developer-friendly test feed that won't block me
url = "https://jsonplaceholder.typicode.com/posts"
req = urllib.request.Request(url)

try:
    # Adding timeout=10 means if it takes longer than 10 seconds,it will stop trying
    print("Connecting and fetching data...")
    with urllib.request.urlopen(req, timeout=10) as response:
        raw_data = response.read()
        #This file contaions a direct list of data cards
        jobs = json.loads(raw_data)

    #1. Choose your search word
    # Python will now pause and wait for you to type your search term!
    keyword = input("Enter a keyword to search for (try 'qui' or 'dolor'):")

    #Open a brand new permanent text file to write into!
    with open("search_results.txt", "w", encoding = "utf-8") as file:

        #we write header to the file.
        #Note: \n tells the computer to jump to a new line (like pressing ENTER)
        file.write(f"--- Search Results For: '{keyword}' ---\n\n")
        
        # FIXED: This loop is now indented so it stays inside the file block!
        for job in jobs:
            #2. The upgraded bouncer loop for job in jobs:
            if keyword in job['title']:
                #Instead of printing to screen, we save it to the file!
                file.write(f"TOPIC: {job['title']}\n")
                file.write(f"DETAIL: {job['body']}\n")
                file.write("_" * 30 + "\n") # Added \n here so the dashes drop down!
                
    print("Success! Your results are soooooo GOATED and saved to search_results.txt!!!")
   
except Exception as e:
    print(f"\nConnection gave an error: {e}")
