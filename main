import json
import urllib.request

url = "https://jsonplaceholder.typicode.com/posts"
req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})

try:
    print("Connecting and fetching data...")
    with urllib.request.urlopen(req, timeout=10) as response:
        raw_data = response.read()
        jobs = json.loads(raw_data)

    # Convert search keyword to lowercase for case insensitive matching
    keyword = input("Enter a keyword to search for (e.g., 'qui' or 'dolor'): ").strip().lower()

    matches_found = 0

    with open("search_results.txt", "w", encoding="utf-8") as file:
        file.write(f"--- Search Results For: '{keyword}' ---\n\n")

        for job in jobs:
            # Case-insensitive title check
            if keyword in job["title"].lower():
                file.write(f"TOPIC: {job['title']}\n")
                file.write(f"DETAIL: {job['body']}\n")
                file.write("-" * 30 + "\n\n")
                matches_found += 1

    print(f"Success! Found {matches_found} matching record(s) saved to search_results.txt.")

except Exception as e:
    print(f"An error occurred during processing: {e}")
